# Environment Configuration
# Set to 'development' for local dev, 'production' for Vercel
VITE_NODE_ENV=development

# Backend API Configuration
# Development URL (when backend is running locally)
VITE_API_BASE_URL_DEV=http://localhost:3001/api/v1

# Production URL (when backend is hosted)
VITE_API_BASE_URL_PROD=https://your-backend-domain.com/api/v1

# Google OAuth Configuration
# Get these values from Google Cloud Console (https://console.cloud.google.com/)

# Your Google OAuth Client ID (for frontend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Development Redirect URI
VITE_GOOGLE_REDIRECT_URI_DEV=http://localhost:5173

# Production Redirect URI
VITE_GOOGLE_REDIRECT_URI_PROD=https://gc-frontend-ten.vercel.app

# Instructions for Google OAuth Setup:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a new project or select existing one
# 3. Enable Google+ API and Google Identity API
# 4. Go to Credentials > Create Credentials > OAuth 2.0 Client IDs
# 5. Set Application type to "Web application"
# 6. Add these to Authorized JavaScript origins:
#    - https://gc-frontend-ten.vercel.app (production)
#    - http://localhost:5173 (development)
# 7. Add these to Authorized redirect URIs:
#    - https://gc-frontend-ten.vercel.app/auth/callback (production)
#    - http://localhost:3001/api/v1/auth/google/callback (backend callback)
# 8. Copy the Client ID and replace 'your-google-client-id-here' above
# 9. Copy the Client Secret and add it to your backend .env file as GOOGLE_CLIENT_SECRET
